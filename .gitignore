# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# GA4 서비스 계정 키 (GitHub에 올리지 않음)
secrets/*
!secrets/.gitkeep
*-service-account*.json
coredxi-web-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Prisma - SQLite 로컬 DB 파일 (GitHub에 올리지 않음)
*.db
*.db-journal
dev.db

.vercel

# Sentry Config File
.env.sentry-build-plugin

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# 쿠키/세션 덤프 (실제 인증 쿠키가 포함될 수 있어 절대 커밋 금지)
cookies.txt
cookies-local.txt
ck.txt
*.cookies.txt

.theme-check/

# Python 캐시 (scripts/ 아래 notion_post_commit.py 등 실행 시 생성)
__pycache__/
*.pyc

# Superpowers subagent-driven-development 작업 공간 (플랜별 원장·브리프·리뷰 산출물)
.superpowers/
.claude/
