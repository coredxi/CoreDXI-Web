// prisma/schema.prisma — CoreDXI 데이터베이스 스키마
//
// Admin: 관리자 계정 (이메일+비밀번호, 역할)
// User: 일반 고객 (OAuth + 이메일 가입) — NextAuth PrismaAdapter 대상
//
// ── 변경 이력 ──────────────────────────────────────────────────────
// v0.5  2026-05-15  Admin / User 모델 분리
// v0.4  2026-05-14  관리자 이메일+비밀번호 로그인용 필드 추가
// v0.3  2026-05-14  Supabase(PostgreSQL)로 전환
// v0.1  2026-05-14  최초 생성
// ────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

// =====================================================
// Admin — 관리자 전용 (OAuth 없음)
// =====================================================
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// User — 일반 고객 (NextAuth PrismaAdapter)
// =====================================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================
// Portfolio — 홍보팀 성공사례(포트폴리오) CMS
// =====================================================
model Portfolio {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  clientName   String
  thumbnailUrl String
  videoUrl     String?
  content      String   @db.Text
  metrics      String
  industry     String?
  solutionType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([industry])
  @@index([solutionType])
}

// =====================================================
// BlogCategory — 블로그 주제(사이드바 메뉴)
// =====================================================
model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  sortOrder   Int        @default(0)
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// =====================================================
// BlogPost — 홍보팀 블로그 (Tiptap doc JSON 본문)
// =====================================================
model BlogPost {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  excerpt     String?        @db.Text
  coverImageUrl String?
  content     Json
  categoryId  String
  category    BlogCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
}

// =====================================================
// OtpCode — 회원가입 이메일 6자리 인증 (5분 유효)
// =====================================================
model OtpCode {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// =====================================================
// PasswordResetToken — Admin·User 공통 비밀번호 재설정(이메일 링크, 1시간 유효)
// (docs/superpowers/specs/2026-08-26-password-reset-design.md 참고)
// accountType 컬럼 없음 — 소비 시 Admin → User 순으로 조회해 일치하는 쪽을 갱신한다.
// =====================================================
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// =====================================================
// PageContent — 홈/소개/솔루션 등 정적 페이지 CMS (범용 key-value)
// page 값: "home" | "about" | "solutions"
// =====================================================
model PageContent {
  id        String   @id @default(cuid())
  page      String   @unique
  content   Json
  updatedAt DateTime @updatedAt
}

// =====================================================
// RateLimitHit — 관리자 로그인·문의 폼 등 요청 빈도 제한용 기록
// =====================================================
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// =====================================================
// NewsletterSubscriber — 블로그 뉴스레터 구독자
// (docs/superpowers/specs/2026-08-08-newsletter-design.md 참고)
// =====================================================
enum NewsletterSubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id               String                     @id @default(cuid())
  email            String                     @unique
  status           NewsletterSubscriberStatus @default(SUBSCRIBED)
  unsubscribeToken String                     @unique
  resendContactId  String?
  source           String?
  subscribedAt     DateTime                   @default(now())
  unsubscribedAt   DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([status])
}

// =====================================================
// AxCheckResponse — 영업 지원 트랙(Phase 1.5) AX 체크(인터뷰 깔때기) 리드
// (docs/superpowers/specs/2026-08-22-sales-funnel-ax-check-design.md 참고)
// =====================================================
enum LeadGrade {
  HOT
  WARM
  COLD
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING
  CLOSED
}

enum FollowupStatus {
  SCHEDULED
  HELD
  SENDING
  SENT
  FAILED
  SKIPPED
}

model AxCheckResponse {
  id             String     @id @default(cuid())
  refCode        String? // ?ref= (영업이사 식별, 예: sales-kim)
  company        String
  name           String
  email          String
  phone          String?
  answers        Json // { q1: "...", q3: ["...","..."], ... } — catalogVersion 함께 저장
  catalogVersion String // 질문지 버전 (v1-draft)
  grade          LeadGrade
  score          Int // 규칙 점수(정렬용)
  summary        Json // 화면/메일에 보여준 우선 과제 3개 (재현 가능하도록 저장)
  status         LeadStatus @default(NEW)
  note           String?    @db.Text // 영업이사 메모
  marketingOptIn Boolean    @default(false) // 선택 동의 → NewsletterSubscriber 연동 여부
  resultToken    String     @unique // /ax-check/result/[token] 재열람용(메일 링크)
  followupStatus      FollowupStatus @default(SCHEDULED)
  followupScheduledAt DateTime?
  followupSentAt      DateTime?
  followupSubject     String?
  followupBody        String?        @db.Text
  followupError       String?
  followupAttempts    Int            @default(0)
  t0SentAt            DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([grade, createdAt])
  @@index([status])
  @@index([refCode])
  @@index([email])
  @@index([followupStatus, followupScheduledAt])
}
