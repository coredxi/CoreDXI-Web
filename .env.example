# =====================================================
# CoreDXI 환경 변수 설정 예시 파일
# 실제 값은 .env 파일에 넣으세요 (.env는 .gitignore에 포함되어 커밋되지 않습니다).
# =====================================================

# Supabase PostgreSQL — 커넥션 풀링 (런타임 쿼리용, pgbouncer, 포트 6543)
# [YOUR-PASSWORD] 부분을 Supabase 대시보드의 실제 DB 비밀번호로 교체하세요.
DATABASE_URL=

# Supabase PostgreSQL — 직접 연결 (마이그레이션 전용, 포트 5432)
DIRECT_URL=

# Google OAuth 설정
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth 필수 설정
# 로컬 개발 중일 때는 localhost, 배포 시에는 실제 도메인을 넣습니다.
NEXTAUTH_URL=http://localhost:3100
# 32자 이상의 무작위 문자열 (예: openssl rand -base64 32)
NEXTAUTH_SECRET=

RESEND_API_KEY=

# (선택) 뉴스레터 구독자를 Resend Audiences에도 동기화하려면 설정
# Resend 대시보드 → Audiences에서 생성한 Audience ID
# 미설정 시에도 뉴스레터 구독 기능 자체는 정상 동작(로컬 DB에만 저장)
RESEND_AUDIENCE_ID=

# Kakao Login
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Naver Login
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Auth.js(NextAuth v5) 필수 설정 — NEXTAUTH_*와 동일한 값을 사용
AUTH_URL=http://localhost:3100
AUTH_SECRET=

# Supabase Storage (블로그 이미지 — blog-images 버킷)
# 대시보드: Project Settings → API → Project URL / service_role (secret)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics (gtag.js)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Analytics Data API (관리자 대시보드)
# 속성 ID: GA4 관리 → 속성 설정 → 속성 ID (숫자, G- 로 시작하는 측정 ID와 다름)
GA4_PROPERTY_ID=
# Vercel 등: 서비스 계정 JSON 전체를 한 줄로 붙여넣기
GA4_SERVICE_ACCOUNT_JSON=
# 로컬: secrets/ga4-service-account.json 경로 (위 JSON 변수가 있으면 무시됨)
GA4_SERVICE_ACCOUNT_PATH=

# Notion 연동 — 현재는 git post-commit 훅의 개발 워크플로 기록용으로만 사용
NOTION_TOKEN=
NOTION_PROJECTS_DB_ID=
NOTION_DOCUMENTS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_BUGTRACKER_DB_ID=
NOTION_DEPLOYMENTLOG_DB_ID=
NOTION_PORTFOLIO_DB_ID=
NOTION_TEMPLATESTOOLS_DB_ID=
# Git post-commit 훅용 — CoreDXI-Web Projects 페이지 ID
NOTION_PROJECT_PAGE_ID=
# (선택) 커밋 시 Tasks '사용 도구'에 기록할 값: Claude Code | Cursor | 기타
# VIBE_CODING_TOOL=

# (선택) /setup 최초 관리자 등록 시 추가 확인 토큰 — 미설정 시 확인 절차 생략
# SETUP_SECRET=

# (선택) Playwright E2E 관리자 로그인/블로그 발행 테스트 활성화용
# 설정하지 않으면 해당 테스트는 자동으로 skip됩니다.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=

# (선택) AX 체크(/ax-check) 제출 시 영업이사 알림 메일을 받을 주소(수신, to)
# 미설정 시 contact_settings.notification_email(문의 알림 메일)로 폴백
# 프로덕션(2026-09-05 결정): 영업이사 obaamg1017@coredxi.com
# SALES_NOTIFY_EMAIL=

# (선택) 위 알림 메일의 참조(cc) 주소 — 기술이사 참고용. 수신 주소와 같으면 무시된다
# 프로덕션(2026-09-05 결정): 기술이사 devcoredxi00@coredxi.com
# SALES_NOTIFY_CC_EMAIL=

# 팔로업(T0/T1) 자동 발송 크론 인증 — Vercel Cron이 Authorization: Bearer 헤더로 보낸다
# 랜덤 32자 이상 문자열 (예: openssl rand -hex 32)
CRON_SECRET=

# (선택) T0·T1 메일의 reply-to 주소. 미설정 시 SALES_SIGNATURE.email로 폴백
# SALES_REPLY_TO=obaamg1017@coredxi.com

# (선택) T0 메일에 넣을 AX 전환 컨설팅 소개서 링크. 미설정 시 소개서 줄이 통째로 빠진다
# 프로덕션 예시: https://www.coredxi.com/docs/coredxi-ax-consulting-brochure.pdf
# AX_CHECK_BROCHURE_URL=

# (선택) 자동 발송 킬 스위치. false로 설정하면 신규 리드는 HELD로 저장되고
# T0도 보내지 않으며, 크론은 즉시 no-op으로 종료된다(8/30 수동 모드로 즉시 복귀).
# 기본값(미설정)은 true와 동일.
# AX_CHECK_FOLLOWUP_ENABLED=
